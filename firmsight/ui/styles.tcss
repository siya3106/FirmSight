Screen {
    background: #0f172a;
    color: #e2e8f0;
}

Header {
    background: #1e293b;
    color: #38bdf8;
    text-style: bold;
    dock: top;
    height: 3;
}

Footer {
    background: #1e293b;
    dock: bottom;
    height: 1;
}

#main-container {
    layout: grid;
    grid-size: 2 2;
    grid-rows: 1fr 1fr;
    grid-columns: 1fr 1fr;
    height: 100%;
}

.box {
    border: round #334155;
    background: #1e293b;
    padding: 1;
    margin: 1;
    height: 100%;
}

.box-title {
    dock: top;
    text-style: bold;
    color: #38bdf8;
    background: #0f172a;
    padding: 0 1;
    margin-bottom: 1;
}

#fs-container {
    row-span: 2;
}

#log-viewer {
    overflow-y: scroll;
    background: #090d16;
    color: #10b981;
    font-family: monospace;
}

#net-table {
    height: 100%;
    background: #090d16;
}

#mem-viewer {
    height: 100%;
    background: #090d16;
}

.status-badge {
    background: #dc2626;
    color: #ffffff;
    text-style: bold;
    padding: 0 1;
}

.status-active {
    background: #16a34a;
}
